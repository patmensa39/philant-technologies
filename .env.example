# Copy to .env.local for development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keystatic admin (production only). Format: owner/repo
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=patmensa39/philant-technologies
# Set to github in local dev ONLY for the one-time GitHub App setup (see README)
KEYSTATIC_STORAGE=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Contact form (added in Phase 5)
RESEND_API_KEY=
CONTACT_TO_EMAIL=your-inbox@example.com
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

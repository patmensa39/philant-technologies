# Copy to .env.local for development. Never commit real values.
# On Vercel, add these under Project Settings > Environment Variables.

# Your live address, for example https://philant-technologies.vercel.app (optional on Vercel, which supplies a fallback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email delivery (server-side only; never prefix these with NEXT_PUBLIC_)
RESEND_API_KEY=
# Optional. Defaults to patmensa39@gmail.com
CONTACT_TO_EMAIL=
# Optional. Defaults to onboarding@resend.dev, which Resend only allows to deliver to your own Resend account email
CONTACT_FROM_EMAIL=
# Optional. Only used for testing against a local mock of the email service
RESEND_API_URL=

# Keystatic admin (production only). Format: owner/repo
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=patmensa39/philant-technologies
# Set to github in local dev ONLY for the one-time GitHub App setup (see docs/DEPLOYMENT.md)
KEYSTATIC_STORAGE=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
